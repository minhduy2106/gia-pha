# Chép file này thành .env rồi đổi mật khẩu
GIAPHA_TEN_HO=Gia phả họ Nguyễn
# Mật khẩu xem: gửi cho cả họ (ít nhất 6 ký tự)
GIAPHA_MAT_KHAU_XEM=doi-mat-khau-xem
# Mật khẩu sửa: chỉ 1-2 người giữ sổ biết (ít nhất 10 ký tự)
GIAPHA_MAT_KHAU_SUA=doi-mat-khau-sua-dai-hon
PORT=3000
# Đặt 1 khi chạy sau HTTPS, để cookie chỉ gửi qua kết nối mã hóa
GIAPHA_HTTPS=0
# Đặt 1 khi chạy sau Cloudflare Tunnel: lấy IP thật để chặn dò mật khẩu, chỉ nghe ở 127.0.0.1
GIAPHA_SAU_PROXY=0
